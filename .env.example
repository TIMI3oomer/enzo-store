# Copy this file to ".env" and fill in your real Supabase project values.
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The Node backend (see /server). Only used for auth token verification
# target — the frontend calls this for all product/order/admin data now.
VITE_API_URL=http://localhost:4000/api
